<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.s8139858.assignment2.ui.login.LoginFragment"
        android:label="@string/login_label">
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.s8139858.assignment2.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_label">
        <argument
            android:name="keypass"
            app:argType="string" />
        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.s8139858.assignment2.ui.details.DetailsFragment"
        android:label="@string/details_label">
        <argument
            android:name="entity"
            app:argType="com.s8139858.assignment2.domain.model.Entity" />
    </fragment>

</navigation>
